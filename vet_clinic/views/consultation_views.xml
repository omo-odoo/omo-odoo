<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vet_consultation_view_form" model="ir.ui.view">
        <field name="name">vet.consultation.form</field>
        <field name="model">vet.consultation</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Démarrer" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_done" type="object" string="Terminer" class="btn-primary" invisible="state != 'in_progress'"/>
                    <button name="action_create_invoice" type="object" string="Créer la facture" class="btn-primary" invisible="state != 'done'"/>
                    <button name="action_cancel" type="object" string="Annuler" invisible="state in ('invoiced', 'cancel')"/>
                    <button name="action_draft" type="object" string="Remettre en planifié" invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done,invoiced"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoice" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="not invoice_id">
                            <span>Facture</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="animal_id" readonly="state in ('done', 'invoiced')"/>
                            <field name="owner_id"/>
                            <field name="species_id"/>
                            <field name="consultation_type"/>
                            <field name="reason"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="duration" widget="float_time"/>
                            <field name="veterinarian_id"/>
                            <field name="invoice_id" invisible="not invoice_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Examen clinique" name="exam">
                            <group>
                                <group>
                                    <field name="weight"/>
                                    <field name="temperature"/>
                                </group>
                            </group>
                            <group>
                                <field name="symptoms"/>
                                <field name="diagnosis"/>
                                <field name="treatment"/>
                            </group>
                        </page>
                        <page string="Actes et produits" name="lines">
                            <field name="line_ids" readonly="state == 'invoiced'">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="subtotal" sum="Total"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="currency_id" invisible="1"/>
                                <field name="amount_total"/>
                            </group>
                        </page>
                        <page string="Vaccins administrés" name="vaccines">
                            <field name="vaccination_ids" context="{'default_animal_id': animal_id}">
                                <list editable="bottom">
                                    <field name="animal_id" column_invisible="1"/>
                                    <field name="vaccine_id"/>
                                    <field name="date"/>
                                    <field name="batch_number"/>
                                    <field name="next_date"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="vet_consultation_view_list" model="ir.ui.view">
        <field name="name">vet.consultation.list</field>
        <field name="model">vet.consultation</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancel'" decoration-danger="consultation_type == 'emergency' and state in ('draft', 'in_progress')">
                <field name="name"/>
                <field name="date"/>
                <field name="animal_id"/>
                <field name="owner_id"/>
                <field name="consultation_type"/>
                <field name="reason" optional="show"/>
                <field name="veterinarian_id" widget="many2one_avatar_user" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount_total" sum="Total" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'in_progress'"
                       decoration-success="state in ('done', 'invoiced')"/>
            </list>
        </field>
    </record>

    <record id="vet_consultation_view_kanban" model="ir.ui.view">
        <field name="name">vet.consultation.kanban</field>
        <field name="model">vet.consultation</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" highlight_color="color">
                <field name="color"/>
                <templates>
                    <t t-name="card">
                        <field name="name" class="fw-bold"/>
                        <field name="animal_id" class="fs-5"/>
                        <field name="owner_id" class="text-muted"/>
                        <div><field name="consultation_type"/> · <field name="date" widget="datetime"/></div>
                        <footer>
                            <field name="amount_total" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="veterinarian_id" widget="many2one_avatar_user" class="ms-auto"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="vet_consultation_view_calendar" model="ir.ui.view">
        <field name="name">vet.consultation.calendar</field>
        <field name="model">vet.consultation</field>
        <field name="arch" type="xml">
            <calendar date_start="date" date_delay="duration" color="veterinarian_id" mode="week" quick_create="0">
                <field name="animal_id"/>
                <field name="owner_id"/>
                <field name="consultation_type"/>
                <field name="veterinarian_id" filters="1"/>
            </calendar>
        </field>
    </record>

    <record id="vet_consultation_view_search" model="ir.ui.view">
        <field name="name">vet.consultation.search</field>
        <field name="model">vet.consultation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="animal_id"/>
                <field name="owner_id"/>
                <field name="veterinarian_id"/>
                <filter name="my" string="Mes consultations" domain="[('veterinarian_id', '=', uid)]"/>
                <filter name="today" string="Aujourd'hui"
                        domain="[('date', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0, 0, 0)).to_utc().strftime('%Y-%m-%d %H:%M:%S')), ('date', '&lt;=', datetime.datetime.combine(context_today(), datetime.time(23, 59, 59)).to_utc().strftime('%Y-%m-%d %H:%M:%S'))]"/>
                <filter name="emergency" string="Urgences" domain="[('consultation_type', '=', 'emergency')]"/>
                <separator/>
                <filter name="to_invoice" string="À facturer" domain="[('state', '=', 'done')]"/>
                <group>
                    <filter name="group_vet" string="Vétérinaire" context="{'group_by': 'veterinarian_id'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'consultation_type'}"/>
                    <filter name="group_species" string="Espèce" context="{'group_by': 'species_id'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="vet_consultation_view_pivot" model="ir.ui.view">
        <field name="name">vet.consultation.pivot</field>
        <field name="model">vet.consultation</field>
        <field name="arch" type="xml">
            <pivot string="Analyse des consultations">
                <field name="date" interval="month" type="col"/>
                <field name="consultation_type" type="row"/>
                <field name="amount_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="vet_consultation_action" model="ir.actions.act_window">
        <field name="name">Consultations</field>
        <field name="res_model">vet.consultation</field>
        <field name="view_mode">calendar,list,kanban,form,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Planifiez votre première consultation</p>
        </field>
    </record>

    <record id="vet_consultation_to_invoice_action" model="ir.actions.act_window">
        <field name="name">À facturer</field>
        <field name="res_model">vet.consultation</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_to_invoice': 1}</field>
    </record>
</odoo>
