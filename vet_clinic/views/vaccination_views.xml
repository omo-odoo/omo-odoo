<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vet_vaccination_view_list" model="ir.ui.view">
        <field name="name">vet.vaccination.list</field>
        <field name="model">vet.vaccination</field>
        <field name="arch" type="xml">
            <list>
                <field name="animal_id"/>
                <field name="owner_id"/>
                <field name="vaccine_id"/>
                <field name="date"/>
                <field name="next_date"/>
                <field name="batch_number" optional="hide"/>
                <field name="veterinarian_id" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'valid'"
                       decoration-warning="state == 'due_soon'"
                       decoration-danger="state == 'expired'"/>
            </list>
        </field>
    </record>

    <record id="vet_vaccination_view_form" model="ir.ui.view">
        <field name="name">vet.vaccination.form</field>
        <field name="model">vet.vaccination</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="animal_id"/>
                            <field name="owner_id"/>
                            <field name="vaccine_id"/>
                            <field name="batch_number"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="next_date"/>
                            <field name="state" widget="badge"/>
                            <field name="veterinarian_id"/>
                            <field name="consultation_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="vet_vaccination_view_search" model="ir.ui.view">
        <field name="name">vet.vaccination.search</field>
        <field name="model">vet.vaccination</field>
        <field name="arch" type="xml">
            <search>
                <field name="animal_id"/>
                <field name="owner_id"/>
                <field name="vaccine_id"/>
                <filter name="upcoming" string="Rappels dans 30 jours"
                        domain="[('next_date', '&lt;=', (context_today() + relativedelta(days=30)).strftime('%Y-%m-%d')), ('next_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="overdue" string="Rappels dépassés"
                        domain="[('next_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="group_vaccine" string="Vaccin" context="{'group_by': 'vaccine_id'}"/>
                    <filter name="group_next" string="Mois du rappel" context="{'group_by': 'next_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="vet_vaccination_action" model="ir.actions.act_window">
        <field name="name">Vaccinations</field>
        <field name="res_model">vet.vaccination</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="vet_vaccination_reminder_action" model="ir.actions.act_window">
        <field name="name">Rappels à prévoir</field>
        <field name="res_model">vet.vaccination</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_upcoming': 1}</field>
    </record>
</odoo>
